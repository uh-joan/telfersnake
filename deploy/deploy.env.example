# Copy to deploy/deploy.env (gitignored) and fill in your box's details.
# deploy.sh and enable-site.sh source deploy/deploy.env automatically.
DEPLOY_HOST=your.box.ip.or.hostname
DEPLOY_USER=root
DEPLOY_PATH=/opt/telfersnake
# The external docker network your shared Caddy is on (so Caddy can reach telfersnake:8787):
CADDY_NET=your-shared-caddy-network
# For enable-site.sh only — your shared Caddy's Caddyfile path and container name:
CADDYFILE=/path/to/your/Caddyfile
CADDY=your-caddy-container
